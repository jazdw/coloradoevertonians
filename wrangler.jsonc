{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coloradoevertonians",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Public Turnstile site key (safe to commit). Secrets are set on Cloudflare: see README.
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFXOPzkDGP4SfqkC"
  },
  "routes": [
    { "pattern": "coloradoevertonians.com", "custom_domain": true },
    { "pattern": "www.coloradoevertonians.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // Only /api/* runs the Worker; every other request is served straight from ./public
    "run_worker_first": ["/api/*"]
  }
}
